		      }
	  });
}

function removeFromReadList(writer,posting){

	  $.ajax({
	      type: "POST",
	      url: "https://www.booksie.com/public/ajax/ajax-remove-from-read-list",
	      data: {writer_id:writer,posting_id:posting},
	      dataType:'json',
