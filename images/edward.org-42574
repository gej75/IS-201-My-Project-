			</label>
			<div class="iComment-buttons">
				<button class="iComment-addvid-btn button is-info is-small">Add video</button>
     		<button class="iComment-addpic-btn button is-info is-small">Add picture</button>
				<button class="iComment-submit-btn button is-primary is-small" data-inline="true">Submit</button>
				<button class="iComment-cancel-btn button is-warning is-small" data-inline="true">Cancel</button>
        <button class="iComment-delete-btn secondary button is-small is-warning">Delete</button>
			</div>
		</div>
	</div>

	<div class="iComment-warning iComment-warning-badselection">
