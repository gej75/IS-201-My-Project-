	      <p class="iComment-buttons">
	        <button class="iComment-standard-button iComment-submit-btn button is-info is-small">Insert</button>
	        <button class="iComment-standard-button iComment-cancel-btn button is-warning is-small">Cancel</button>
	      </p>
	    </div>

	<div class="iComment-form-new">
