			    	$('#feedback_box_'+data.wcr_id).html("<p class='text-center'><span class='badge badge-success left_shadow'><i class='icon-ok icon-white'></i> <strong>Applied Feedback</strong></span>" +
			    			" <span class='feedback_uncheck label' id='uncheck_"+data.wcr_id+"'><i class='icon-remove-sign icon-white'></i></span></p>");		    	
		      }
	  });
	});
	$('.feedback_box').on('click','.feedback_uncheck',function() {
		comment_id=$(this).attr('id');
		data=comment_id.split('_');
		id = data[1];
		
		$.ajax({
		      type: "POST",
		      url: "https://www.booksie.com/public/ajax/uncheck-feedback-regular-review",
		      data: {comment_id:id},
		      dataType:'json',
		      success: function(data) {  
			    	$('#feedback_badge_'+data.wcr_id).hide();
			    	$('#uncheck_'+data.wcr_id).hide();
			    	$('#feedback_box_'+data.wcr_id).html("<button class='feedback_check btn btn-mini btn_blue_wrap left_shadow' id='feedback_"+data.wcr_id+"'><i class='icon-ok'></i> Check as <strong>Applied Feedback</strong></button> ");		    	
		      }
	  });
	});
});    //-->
</script>
