 });
}

function likePosting(writer,posting,visible){

	  $.ajax({
	      type: "POST",
	      url: "https://www.booksie.com/public/ajax/ajax-like-posting",
	      data: {writer_id:writer,posting_id:posting},
	      dataType:'json',
	      success: function(data) {
	    	    /*url = "";*/
	            $('.like-posting').html("<a href=\"#\" title=\"This book is liked\" class=\"button is-small\"><span class=\"pr-1\"><i class=\"far fa-smile\"></i></span> Liked</a>");
	            $('.like-posting').attr('class', 'unlike-posting');
	            $('body').on('click', '.unlike-posting',function(e){e.preventDefault();unlikePosting(data.wl_user_id,data.wl_posting_id)});
	      }
   });
}

function unlikePosting(writer,posting){

	var answer = confirm("Are you sure you want to unlike this posting ?")
    if (answer){
	  $.ajax({
	      type: "POST",
	      url: "https://www.booksie.com/public/ajax/ajax-unlike-posting",
	      data: {writer_id:writer,posting_id:posting},
	      dataType:'json',
	      success: function(data) {
	           /*$('body').on('click', '#add-read-list',function(e){e.preventDefault();addToReadList(data.rl_writer_id,data.rl_post_id)});*/
	    	  $('.unlike-posting').html("<a href=\"#\" title=\"Like\" class=\"button is-small\"><span class=\"pr-1\"><i class=\"far fa-smile\"></i></span> Like</a>");
	    	  $('.unlike-posting').attr('class','like-posting');
	    	  $('body').on('click', '.like-posting',function(e){e.preventDefault();likePosting(data.wl_user_id,data.wl_posting_id,null)});
	      }
     });
    }
}    //-->
</script>
