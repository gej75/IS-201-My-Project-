	          data:  {wp_id : wp_id,spam_value:1},
	          dataType:'json',
	          success: function(result){
                    /*console.log(result.wp_spam);*/
                    $(".spam_message").fadeIn();
                    $(".mark_spam").html("<span class='padd-right10'>Moderate this content:</span> <a class='unspam_button btn btn-inverse btn-small btn-posting' id='unspam_"+result.wp_id+"'><i class='fa fa-eye'></i> <strong>Unspam</strong></a>");
                    $(".sp_message").html("<p class='text-error padd-left10'>This content is flagged as spam </p>");
                    $(".any_message").hide();
	          }
	        });
          });

	        $(".mark_spam_wr_moderator").on("click",'.spam_button', function(){
                id=$(this).attr('id');
                data=id.split('_');
                wp_id=data[1];
                /*wp_id=$(this).data('postingid');*/
            $.ajax({
              type: "POST",
              url: "/public/ajax/spam-posting/",
              data:  {wp_id : wp_id,spam_value:2},
              dataType:'json',
              success: function(result){
                /*console.log(result.wp_spam);*/
                $(".spam_message").fadeIn();
                $(".mark_spam").html("<span class='padd-right10'>Moderate this content:</span> <a class='unspam_button btn btn-inverse btn-small btn-posting' id='unspam_"+result.wp_id+"'><i class='fa fa-eye'></i> <strong>Unspam</strong></a>");
                $(".sp_message").html("<p class='text-error padd-left10'>This content is flagged as spam </p>");
                $(".any_message").hide();
          }
        });
      });

});

$(document).ready(function() {
    $(".mark_spam, .mark_spam_wr_moderator").on("click", '.unspam_button',function(){
            id=$(this).attr('id');
            data=id.split('_');
            wp_id=data[1];
            /*wp_id=$(this).data('postingid');*/
    $.ajax({
      type: "POST",
      url: "/public/ajax/un-spam-posting/",
      data:  {wp_id : wp_id},
      dataType:'json',
      success: function(result){
            /*console.log(result.wp_spam);*/
            $(".spam_message").hide();
            $(".mark_spam").html("<span class='padd-right10'>Moderate this content:</span> <a class='spam_button btn btn-inverse btn-small btn-posting' id='spam_"+result.wp_id+"'><i class='fa fa-ban'></i> <strong>Spam</strong></a>");
            $(".sp_message").html('');
            $(".any_message").html("<div class='alert alert-block alert-dismissible text-center'><button type='button' class='close btn-close' data-dismiss='alert' data-bs-dismiss='alert'>&times;</button><p class='text-info'><strong>This content was removed from spam !</strong></p></div>").fadeIn();
      }
    });
  });

});


$(document).ready(function() {

	$(".report_flag").on("click",'.report_posting', function(){

		var msj='Are you sure you want to report this content as inappropiate?';
	    if (!confirm(msj)){
		      return false;
        }else{
            id=$(this).attr('id');
            data=id.split('_');
            wp_id=data[1];
            /*wp_id=$(this).data('postingid');*/
          $.ajax({
          type: "POST",
          url: "/public/ajax/report-inappropiate-posting/",
          data:  {wp_id : wp_id},
          dataType:'json',
          success: function(result){
               /*console.log(result.wp_report_flag);*/
               $(".report_flag").html("<p><a href=\"#\" class='unreport_posting' id='unreport_"+result.wp_id+"'><i class='fa fa-bell-slash-o'></i> <strong>Unreport</strong></a></p>");
               $(".any_message").html("<div class='alert alert-block alert-dismissible text-center'><button type='button' class='close btn-close' data-dismiss='alert' data-bs-dismiss='alert'>&times;</button><p class='text-info'><strong>This content was reported by you to the admin!</strong></p></div>").fadeIn();
          }
        });
       }
     });

});

$(document).ready(function() {
    $(".report_flag").on("click",'.unreport_posting ', function(){

    	var msj='Are you sure you want to remove this report?';
    	if (!confirm(msj)){
    		  return false;
        }else{
               id=$(this).attr('id');
               data=id.split('_');
               wp_id=data[1];
              /*wp_id=$(this).data('postingid');*/
               $.ajax({
                   type: "POST",
                   url: "/public/ajax/un-report-inappropiate-posting/",
                   data:  {wp_id : wp_id},
                   dataType:'json',
                   success: function(result){
                     /*console.log(result.wp_report_flag);*/
                      $(".report_flag").html("<p><a href=\"#\" class='report_posting' id='report_"+result.wp_id+"'><i class='fa fa-bell-o'></i> <strong>Report</strong></a></p>");
                      $(".any_message").html("<div class='alert alert-block alert-dismissible text-center'><button type='button' class='close btn-close' data-dismiss='alert' data-bs-dismiss='alert'>&times;</button><p class='text-info'><strong>This content was removed from reports to admin!</strong></p></div>").fadeIn();
                  }
               });
        }
     });

});
    //-->
</script>
